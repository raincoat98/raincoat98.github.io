---
import type { Post } from "../lib/posts";

interface Props {
  posts: Post[];
  categories: string[];
  totalCount: number;
  currentPage: number;
  totalPages: number;
  headingLevel?: "h1" | "h2";
}

const {
  posts,
  categories,
  totalCount,
  currentPage,
  totalPages,
  headingLevel = "h2",
} = Astro.props;

const fmtDate = (date?: Date) =>
  date ? new Intl.DateTimeFormat("ko-KR", { year: "numeric", month: "short", day: "numeric" }).format(date) : "";
const pageHref = (page: number) => page === 1 ? "/#latest-posts" : `/page/${page}/#latest-posts`;
---
<div class:list={["layout", { "page-layout": headingLevel === "h1" }]} data-pagefind-ignore>
  <div class="toolbar">
    <div>
      {headingLevel === "h1" ? (
        <h1 id="latest-posts" class="section-title">최신 글</h1>
      ) : (
        <h2 id="latest-posts" class="section-title">최신 글</h2>
      )}
      <p class="section-sub">총 {totalCount}개</p>
    </div>
    <div class="cat-links" aria-label="카테고리">
      {categories.map((category) => (
        <a href={`/category/${category.toLowerCase()}`} class="cat-chip">{category}</a>
      ))}
    </div>
  </div>

  <div class="posts-grid">
    {posts.map((post) => (
      <a class="card" href={`/${post.id}/`}>
        <div class="card-top">
          <span class="badge">{post.data.categories[0]?.split("|")[0].trim() || "글"}</span>
          <time datetime={post.data.created?.toISOString()}>{fmtDate(post.data.created ?? post.data.date)}</time>
        </div>
        <h3>{post.data.title}</h3>
        {post.data.description && <p class="desc">{post.data.description}</p>}
        <div class="card-foot">
          {post.data.readingTime && <span>약 {post.data.readingTime}분</span>}
          <span class="arrow" aria-hidden="true">→</span>
        </div>
      </a>
    ))}
  </div>

  {totalPages > 1 && (
    <nav class="pagination" aria-label="최신 글 페이지">
      {currentPage > 1 ? (
        <a class="page-link direction" href={pageHref(currentPage - 1)} rel="prev" aria-label="이전 페이지">
          <svg class="direction-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" aria-hidden="true">
            <path d="m12.5 5-5 5 5 5"></path>
          </svg>
        </a>
      ) : (
        <span class="page-link direction disabled" aria-label="이전 페이지 없음" aria-disabled="true">
          <svg class="direction-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" aria-hidden="true">
            <path d="m12.5 5-5 5 5 5"></path>
          </svg>
        </span>
      )}
      <div class="page-numbers">
        {Array.from({ length: totalPages }, (_, index) => index + 1).map((page) => (
          page === currentPage ? (
            <span class="page-link current" aria-current="page" aria-label={`${page}페이지, 현재 페이지`}>{page}</span>
          ) : (
            <a class="page-link" href={pageHref(page)} aria-label={`${page}페이지`}>{page}</a>
          )
        ))}
      </div>
      {currentPage < totalPages ? (
        <a class="page-link direction" href={pageHref(currentPage + 1)} rel="next" aria-label="다음 페이지">
          <svg class="direction-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" aria-hidden="true">
            <path d="m7.5 5 5 5-5 5"></path>
          </svg>
        </a>
      ) : (
        <span class="page-link direction disabled" aria-label="다음 페이지 없음" aria-disabled="true">
          <svg class="direction-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" aria-hidden="true">
            <path d="m7.5 5 5 5-5 5"></path>
          </svg>
        </span>
      )}
    </nav>
  )}
</div>

<style>
  .layout {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 2.8rem 1.25rem 4rem;
  }
  .page-layout { padding-top: 3.5rem; }
  .toolbar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.6rem;
  }
  .section-title { margin: 0; font-size: 1.5rem; }
  .section-sub { margin: 0.2rem 0 0; color: var(--text-3); font-size: 0.92rem; }
  .cat-links { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .cat-chip {
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-2);
    font-size: 0.85rem;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .cat-chip:hover { border-color: var(--brand); color: var(--brand); text-decoration: none; }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.2rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 1.3rem 1.4rem;
    color: inherit;
    box-shadow: var(--shadow-sm);
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: var(--brand);
    box-shadow: var(--shadow-md);
    text-decoration: none;
  }
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }
  .badge {
    background: var(--brand-soft);
    color: var(--brand-strong);
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
  }
  .card-top time { color: var(--text-3); font-size: 0.82rem; }
  .card h3 { margin: 0.2rem 0 0; font-size: 1.08rem; line-height: 1.4; }
  .card .desc {
    color: var(--text-2);
    font-size: 0.9rem;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }
  .card-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--text-3);
    font-size: 0.85rem;
    margin-top: 0.3rem;
  }
  .card-foot .arrow { color: var(--brand); font-weight: 700; transition: transform 0.15s ease; }
  .card:hover .arrow { transform: translateX(3px); }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    margin-top: 2.5rem;
  }
  .page-numbers { display: flex; gap: 0.35rem; }
  .page-link {
    display: inline-flex;
    min-width: 2.35rem;
    min-height: 2.35rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text-2);
    box-shadow: var(--shadow-sm);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1;
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }
  a.page-link:hover {
    border-color: var(--brand);
    background: var(--brand-soft);
    color: var(--brand-strong);
    text-decoration: none;
  }
  .page-link.current {
    border-color: transparent;
    background: linear-gradient(135deg, var(--brand-fill), var(--brand-fill-strong));
    color: #fff;
  }
  .page-link.direction { color: var(--text-2); }
  .direction-icon {
    width: 0.72rem;
    height: 0.72rem;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.85;
  }
  .page-link.disabled {
    color: var(--text-3);
    opacity: 0.4;
  }

  @media (max-width: 640px) {
    .posts-grid { grid-template-columns: 1fr; }
  }
</style>
