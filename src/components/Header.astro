---
import ThemeToggle from "./ThemeToggle.astro";
import SearchOverlay from "./SearchOverlay.astro";
const nav = [
  { text: "홈", href: "/" },
  { text: "소개", href: "/introduce/my-develop" },
  { text: "Git", href: "/git/git-complete-guide" },
  { text: "프론트엔드", href: "/category/react" },
  { text: "데이터베이스", href: "/category/database" },
  { text: "태그", href: "/tags" },
];
const current = Astro.url;
const isActiveHome = current.pathname === "/";
---
<header class="site-header">
  <div class="header-inner">
    <a class="logo" href="/" aria-label="Raincoat 블로그 홈">
      <span class="logo-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none">
          <path d="M5.5 17.5 A10.5 9.5 0 0 1 26.5 17.5 Z" fill="currentColor"/>
          <path d="M16 17.5 L16 24.5 Q16 27.5 13.2 27.5 Q10.5 27.5 10.5 25 Q10.5 23.5 12.2 23.5"
                stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="logo-text">Raincoat</span>
    </a>

    <nav aria-label="주요 탐색" class="nav-desktop">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={{
                  active:
                    (isActiveHome && item.href === "/") ||
                    (item.href !== "/" && current.pathname.startsWith(item.href)),
                }}
              >
                {item.text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <SearchOverlay />
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 1.25rem;
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--text);
    flex-shrink: 0;
  }
  .logo:hover { text-decoration: none; }
  .logo-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: linear-gradient(135deg, var(--brand-fill), var(--brand-fill-strong));
    color: #fff;
    box-shadow: 0 4px 12px -4px var(--brand-glow);
  }
  .logo-mark svg {
    width: 20px;
    height: 20px;
    display: block;
  }
  .logo-text {
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }
  .nav-desktop ul {
    list-style: none;
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
  }
  .nav-desktop a {
    display: inline-block;
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    color: var(--text-2);
    font-size: 0.92rem;
    font-weight: 500;
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .nav-desktop a:hover {
    color: var(--text);
    background: var(--bg-alt);
    text-decoration: none;
  }
  .nav-desktop a.active {
    color: var(--brand);
    background: var(--brand-soft);
    font-weight: 600;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  @media (max-width: 720px) {
    .nav-desktop { display: none; }
  }
</style>