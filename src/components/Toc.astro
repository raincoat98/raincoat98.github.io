---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}
const { headings } = Astro.props;
---
<aside class="toc" aria-label="목차" data-toc>
  <p class="toc-title">목차</p>
  <button class="toc-toggle" type="button" data-toc-toggle aria-expanded="false" aria-controls="post-toc-list" hidden>
    <svg class="toc-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" aria-hidden="true">
      <path d="M5.5 4h8M5.5 8h8m-8 4h8M2.5 4h.01m-.01 4h.01m-.01 4h.01" stroke-width="1.5" stroke-linecap="round" />
    </svg>
    목차
    <svg class="toc-chevron" width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" aria-hidden="true">
      <path d="m4 6 4 4 4-4" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <nav id="post-toc-list" aria-label="글의 목차">
    <ol>
      {
        headings.map((h) => (
          <li class:list={{ "is-h3": h.depth === 3 }}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))
      }
    </ol>
  </nav>
</aside>

<script>
  const toc = document.querySelector("[data-toc]");
  const toggle = toc?.querySelector<HTMLButtonElement>("[data-toc-toggle]");
  const panel = toc?.querySelector("nav");

  if (toc && toggle && panel) {
    const sections = Array.from(panel.querySelectorAll("a")).flatMap((link) => {
      const heading = document.getElementById(link.getAttribute("href")!.slice(1));
      return heading ? [{ link, heading }] : [];
    });
    const mobile = window.matchMedia("(max-width: 900px)");
    let active: HTMLAnchorElement | undefined;
    let frame = 0;

    const setActive = (link: HTMLAnchorElement | undefined) => {
      if (link === active) return;
      active?.removeAttribute("aria-current");
      link?.setAttribute("aria-current", "location");
      active = link;
    };

    const updateActive = () => {
      const firstHeading = sections[0]?.heading;
      if (!firstHeading) return;
      const padding = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
      const margin = parseFloat(getComputedStyle(firstHeading).scrollMarginTop) || 0;
      const readingLine = padding + margin + 2;
      let index = sections.length - 1;
      while (index >= 0 && sections[index].heading.getBoundingClientRect().top > readingLine) index--;
      setActive(sections[index]?.link);
    };
    const scheduleUpdate = () => {
      if (!frame) frame = window.requestAnimationFrame(() => {
        frame = 0;
        updateActive();
      });
    };
    const isOpen = () => toggle.getAttribute("aria-expanded") === "true";
    const close = () => toggle.setAttribute("aria-expanded", "false");

    toggle.hidden = false;
    toggle.addEventListener("click", () => {
      if (isOpen()) {
        close();
        return;
      }
      updateActive();
      toggle.setAttribute("aria-expanded", "true");
      if (active) {
        const item = active.getBoundingClientRect();
        const bounds = panel.getBoundingClientRect();
        if (item.top < bounds.top) panel.scrollTop += item.top - bounds.top;
        else if (item.bottom > bounds.bottom) panel.scrollTop += item.bottom - bounds.bottom;
      }
    });
    document.addEventListener("pointerdown", (event) => {
      if (isOpen() && !event.composedPath().includes(toc)) close();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !isOpen()) return;
      if (toc.contains(document.activeElement)) toggle.focus();
      close();
    });
    for (const { link, heading } of sections) {
      link.addEventListener("click", (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        close();
        if (!heading.hasAttribute("tabindex")) heading.tabIndex = -1;
        heading.focus({ preventScroll: true });
      });
    }
    mobile.addEventListener("change", close);
    window.addEventListener("scroll", scheduleUpdate, { passive: true });
    window.addEventListener("resize", scheduleUpdate);
    scheduleUpdate();
  }
</script>

<style>
  .toc {
    grid-area: toc;
    position: sticky;
    top: calc(var(--header-h) + 28px);
    max-height: calc(100vh - var(--header-h) - 56px);
    overflow-y: auto;
    padding: 0 0.5rem 0 0.75rem;
    scrollbar-width: thin;
  }
  .toc-title {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .toc-toggle { display: none; }
  .toc nav ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .toc a {
    display: block;
    padding: 0.32rem 0.6rem;
    border-left: 2px solid var(--border);
    color: var(--text-3);
    font-size: 0.86rem;
    line-height: 1.4;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .toc a:hover { color: var(--text); text-decoration: none; }
  .toc a[aria-current="location"] {
    color: var(--brand);
    border-left-color: var(--brand);
    background: var(--brand-soft);
    font-weight: 600;
  }
  .toc :is(a, button):focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: -2px;
  }

  @media (max-width: 900px) {
    .toc {
      top: calc(var(--header-h) + 0.5rem);
      align-self: start;
      z-index: 35;
      max-height: none;
      padding: 0;
      justify-self: end;
      margin-inline-end: -0.75rem;
      overflow: visible;
    }
    .toc-title { display: none; }
    .toc-toggle:not([hidden]) {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 44px;
      padding: 0 0.85rem;
      border: 1px solid var(--border);
      border-radius: 0.5rem;
      background: var(--surface);
      color: var(--text);
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
    }
    .toc-toggle[aria-expanded="true"] {
      background: var(--brand-soft);
      border-color: var(--brand);
      color: var(--brand-strong);
    }
    .toc-toggle[aria-expanded="true"] .toc-chevron { transform: rotate(180deg); }
    .toc-toggle:not([hidden])[aria-expanded="false"] + nav { display: none; }
    .toc-toggle:not([hidden]) + nav {
      position: absolute;
      inset-block-start: calc(100% + 0.375rem);
      inset-inline-end: 0;
      inline-size: min(19rem, calc(100vw - 2.5rem));
      border: 1px solid var(--border);
      border-radius: 0.5rem;
      background: var(--surface);
      box-shadow: var(--shadow-md);
    }
    .toc nav {
      max-height: min(55dvh, 24rem);
      overflow-y: auto;
      overscroll-behavior-y: contain;
      padding-block: 0.25rem;
    }
    .toc a {
      display: flex;
      align-items: center;
      min-height: 44px;
    }
    .toc .is-h3 a { padding-inline-start: 1.25rem; }
  }
</style>