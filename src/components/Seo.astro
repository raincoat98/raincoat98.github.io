---
interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  path?: string;
  sitename?: string;
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  noindex?: boolean;
  url?: string;
  siteDesc?: string;
  keywords?: string[];
  breadcrumb?: string[];
}

const {
  title,
  description,
  image,
  type = "website",
  path = "/",
  sitename = "Raincoat",
  publishedTime,
  modifiedTime,
  tags = [],
  noindex = false,
  url = "https://raincoat98.github.io",
  siteDesc,
  keywords = [],
  breadcrumb = [],
} = Astro.props;

const finalTitle = title.includes(sitename) ? title : `${title} | ${sitename}`;
const finalDesc = (siteDesc || description) || "프론트엔드 개발자 블로그. 웹 개발 경험과 지식을 공유합니다.";
const finalKeywords =
  keywords.length > 0
    ? keywords.join(", ")
    : "React, Next.js, JavaScript, TypeScript, 프론트엔드 개발, 웹개발, 프론트엔드, UI/UX, 컴포넌트 설계, React Hooks, React Query, Redux, Zustand, Tailwind CSS";
const pathSlug = path === "/" ? "" : path.endsWith("/") ? path : `${path}/`;
const canonical = `${url}${pathSlug}`;
const ogImage = image
  ? image.startsWith("http")
    ? image
    : `${url}${image}`
  : `${url}/og-image.png`;
const authorName = "SangWook Woo";
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{finalTitle}</title>
<meta name="description" content={finalDesc} />
<meta name="author" content={authorName} />
<link rel="canonical" href={canonical} data-pagefind-meta="url[href]" />
{
  noindex
    ? <meta name="robots" content="noindex, nofollow" />
    : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
}
<meta name="keywords" content={finalKeywords} />
<meta name="language" content="Korean" />
<meta name="revisit-after" content="7 days" />
<meta name="generator" content="Astro" />
<meta name="theme-color" content="#646cff" />
<meta name="color-scheme" content="light dark" />
<meta name="format-detection" content="telephone=no" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="alternate icon" href="/favicon.svg" />

<!-- Open Graph / Facebook -->
<meta property="og:site_name" content={sitename} />
<meta property="og:type" content={type} />
<meta property="og:title" content={finalTitle} />
<meta property="og:description" content={finalDesc} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="ko_KR" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
<meta property="og:image:alt" content={title} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@raincoat98" />
<meta name="twitter:creator" content="@raincoat98" />
<meta name="twitter:title" content={finalTitle} />
<meta name="twitter:description" content={finalDesc} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={title} />

<!-- article 구조화 -->
{
  type === "article" && (
    <>
      {tags.map((t) => <meta property="article:tag" content={t} />)}
      {publishedTime && <meta property="article:published_time" content={publishedTime} />}
      {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
      <meta property="article:author" content="https://github.com/raincoat98" />
      <script type="application/ld+json" is:inline set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description: finalDesc,
        author: { "@type": "Person", name: authorName, url: "https://github.com/raincoat98" },
        publisher: {
          "@type": "Organization",
          name: sitename,
          logo: { "@type": "ImageObject", url: `${url}/favicon.svg` },
        },
        url: canonical,
        datePublished: publishedTime || new Date().toISOString(),
        dateModified: modifiedTime || publishedTime || new Date().toISOString(),
        inLanguage: "ko-KR",
        mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
      })} />
    </>
  )
}

<!-- 빵부스러기 -->
{
  breadcrumb.length > 0 && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${url}/` },
        ...breadcrumb.map((seg, i) => ({ "@type": "ListItem", position: i + 2, name: seg, item: `${url}/${seg}` })),
      ],
    })} />
  )
}

<!-- 사이트(홈) 구조화 -->
{
  type === "website" && path === "/" && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: sitename,
      url: `${url}/`,
      description: siteDesc || description || undefined,
      inLanguage: "ko-KR",
      publisher: {
        "@type": "Organization",
        name: sitename,
        logo: { "@type": "ImageObject", url: `${url}/favicon.svg` },
      },
    })} />
  )
}