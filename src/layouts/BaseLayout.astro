---
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  path?: string;
  noindex?: boolean;
  tags?: string[];
  publishedTime?: string;
  modifiedTime?: string;
  breadcrumb?: string[];
}

const {
  title = "Raincoat",
  description,
  image,
  type = "website",
  path = "/",
  noindex = false,
  tags = [],
  publishedTime,
  modifiedTime,
  breadcrumb,
} = Astro.props;
---
<!doctype html>
<html lang="ko-KR">
  <head>
    <meta charset="UTF-8" />
    <!-- 테마 FOUC 방지: 저장값 or 시스템 기본값을 최우선 적용 -->
    <script is:inline>
      (function () {
        var theme = null;
        try { theme = localStorage.getItem("rc-theme"); } catch (e) {}
        if (theme !== "light" && theme !== "dark") {
          theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <Seo
      title={title}
      description={description}
      image={image}
      type={type}
      path={path}
      noindex={noindex}
      tags={tags}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      breadcrumb={breadcrumb}
    />

  </head>
  <body>
    <Header />
    <main id="main" class="site-main">
      <slot />
    </main>
    <Footer />
    <div class="page-scroll" data-page-scroll hidden>
      <button type="button" data-scroll-top aria-label="페이지 상단으로 이동" title="페이지 상단으로">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" aria-hidden="true">
          <path d="m5 12.5 5-5 5 5"></path>
        </svg>
      </button>
      <button type="button" data-scroll-bottom aria-label="페이지 하단으로 이동" title="페이지 하단으로">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" aria-hidden="true">
          <path d="m5 7.5 5 5 5-5"></path>
        </svg>
      </button>
    </div>
    <script>
      const controls = document.querySelector<HTMLElement>("[data-page-scroll]");
      const topButton = controls?.querySelector<HTMLButtonElement>("[data-scroll-top]");
      const bottomButton = controls?.querySelector<HTMLButtonElement>("[data-scroll-bottom]");
      const page = document.scrollingElement;

      if (controls && topButton && bottomButton && page) {
        const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
        let frame = 0;

        const update = () => {
          const max = page.scrollHeight - page.clientHeight;
          const current = page.scrollTop;
          controls.hidden = max <= 1;
          topButton.setAttribute("aria-disabled", String(current <= 1));
          bottomButton.setAttribute("aria-disabled", String(current >= max - 1));
          frame = 0;
        };

        const scheduleUpdate = () => {
          if (!frame) frame = window.requestAnimationFrame(update);
        };
        window.addEventListener("scroll", scheduleUpdate, { passive: true });
        window.addEventListener("resize", scheduleUpdate);
        new ResizeObserver(scheduleUpdate).observe(document.body);

        for (const button of [topButton, bottomButton]) {
          button.addEventListener("click", () => {
            if (button.getAttribute("aria-disabled") === "true") return;
            window.scrollTo({
              top: button === topButton ? 0 : page.scrollHeight - page.clientHeight,
              behavior: motion.matches ? "instant" : "smooth",
            });
          });
        }
        update();
      }
    </script>
    <style>
      .page-scroll {
        position: fixed;
        right: max(1rem, env(safe-area-inset-right));
        bottom: max(1rem, env(safe-area-inset-bottom));
        z-index: 30;
      }
      .page-scroll:not([hidden]) {
        display: grid;
        gap: 0.5rem;
      }
      .page-scroll button {
        display: grid;
        place-items: center;
        inline-size: 2.75rem;
        block-size: 2.75rem;
        padding: 0;
        border: 1px solid var(--border-strong);
        border-radius: 0.5rem;
        background: color-mix(in srgb, var(--surface) 88%, transparent);
        color: var(--text-2);
        box-shadow: var(--shadow-md);
        backdrop-filter: blur(12px);
        cursor: pointer;
        touch-action: manipulation;
      }
      .page-scroll button:hover:not([aria-disabled="true"]) {
        border-color: var(--brand);
        color: var(--brand);
      }
      .page-scroll button:focus-visible {
        outline: 2px solid var(--brand);
        outline-offset: 2px;
      }
      .page-scroll button[aria-disabled="true"] {
        color: var(--text-3);
        cursor: default;
      }
      .page-scroll svg {
        width: 1.15rem;
        height: 1.15rem;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-width: 1.8;
      }
    </style>
  </body>
</html>