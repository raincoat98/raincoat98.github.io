---
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  path?: string;
  noindex?: boolean;
  tags?: string[];
  publishedTime?: string;
  modifiedTime?: string;
  breadcrumb?: string[];
}

const {
  title = "Raincoat",
  description,
  image,
  type = "website",
  path = "/",
  noindex = false,
  tags = [],
  publishedTime,
  modifiedTime,
  breadcrumb,
} = Astro.props;
---
<!doctype html>
<html lang="ko-KR">
  <head>
    <meta charset="UTF-8" />
    <!-- 테마 FOUC 방지: 저장값 or 시스템 기본값을 최우선 적용 -->
    <script is:inline>
      (function () {
        var theme = null;
        try { theme = localStorage.getItem("rc-theme"); } catch (e) {}
        if (theme !== "light" && theme !== "dark") {
          theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <Seo
      title={title}
      description={description}
      image={image}
      type={type}
      path={path}
      noindex={noindex}
      tags={tags}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      breadcrumb={breadcrumb}
    />

  </head>
  <body>
    <Header />
    <main id="main" class="site-main">
      <slot />
    </main>
    <Footer />
  </body>
</html>