---
import BaseLayout from "../layouts/BaseLayout.astro";
import LatestPosts from "../components/LatestPosts.astro";
import { getPostCategories, getPublishedPosts, POSTS_PER_PAGE } from "../lib/posts";

const posts = await getPublishedPosts();
const categories = getPostCategories(posts);
const totalCount = posts.length;
const totalPages = Math.ceil(totalCount / POSTS_PER_PAGE);
const firstPagePosts = posts.slice(0, POSTS_PER_PAGE);
---
<BaseLayout title="Raincoat" description="프론트엔드 개발자 블로그. 웹 개발 경험과 지식을 공유합니다." path="/">
  <section class="hero">
    <div class="hero-inner">
      <span class="hero-eyebrow">Frontend Developer Blog</span>
      <h1 class="hero-title">Raincoat</h1>
      <p class="hero-sub">프론트엔드 개발자 우상욱의 개발 블로그</p>
      <p class="hero-tagline">웹 개발 경험과 지식을 공유합니다</p>
      <div class="hero-actions">
        <a class="btn primary" href="/introduce/my-develop">소개 보기</a>
        <a class="btn ghost" href="/introduce/careers">포트폴리오</a>
      </div>
    </div>
  </section>

  <LatestPosts
    posts={firstPagePosts}
    categories={categories}
    totalCount={totalCount}
    currentPage={1}
    totalPages={totalPages}
  />
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(900px 400px at 50% -20%, var(--brand-glow), transparent 70%),
      var(--bg);
    padding: 5rem 0 4rem;
  }
  .hero-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 1.25rem;
    text-align: center;
  }
  .hero-eyebrow {
    display: inline-block;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand);
    margin-bottom: 0.9rem;
  }
  .hero-title {
    margin: 0;
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, var(--hero-title-start), var(--hero-title-end));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-sub { font-size: 1.2rem; font-weight: 600; color: var(--text); margin: 0.6rem 0 0; }
  .hero-tagline { color: var(--text-2); margin: 0.3rem 0 1.8rem; }
  .hero-actions { display: flex; gap: 0.7rem; justify-content: center; }
  .btn {
    display: inline-flex;
    padding: 0.6rem 1.3rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
  }
  .btn:hover { text-decoration: none; transform: translateY(-2px); }
  .btn.primary {
    background: linear-gradient(135deg, var(--cta-fill), var(--cta-fill-strong));
    color: #fff;
    box-shadow: 0 6px 18px -6px var(--brand-glow);
  }
  .btn.ghost { border: 1px solid var(--border-strong); color: var(--text); background: var(--surface); }


  @media (max-width: 640px) {
    .hero { padding: 3.5rem 0 3rem; }
  }
</style>