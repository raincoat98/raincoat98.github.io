---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const all = await getCollection("docs");
const posts = all
  .filter((p) => !!p.data.title && !p.id.includes("examples/") && !p.data.draft)
  .sort((a, b) => {
    const ad = a.data.created ?? a.data.date;
    const bd = b.data.created ?? b.data.date;
    return (bd?.getTime?.() ?? 0) - (ad?.getTime?.() ?? 0);
  });

const categories = [...new Set(posts.flatMap((p) => p.data.categories.map((c) => c.split("|")[0].trim())))].sort();
const totalCount = posts.length;
const fmtDate = (d?: Date) =>
  d ? new Intl.DateTimeFormat("ko-KR", { year: "numeric", month: "short", day: "numeric" }).format(d) : "";
---
<BaseLayout title="Raincoat" description="프론트엔드 개발자 블로그. 웹 개발 경험과 지식을 공유합니다." path="/">
  <section class="hero">
    <div class="hero-inner">
      <span class="hero-eyebrow">Frontend Developer Blog</span>
      <h1 class="hero-title">Raincoat</h1>
      <p class="hero-sub">프론트엔드 개발자 우상욱의 개발 블로그</p>
      <p class="hero-tagline">웹 개발 경험과 지식을 공유합니다</p>
      <div class="hero-actions">
        <a class="btn primary" href="/introduce/my-develop">소개 보기</a>
        <a class="btn ghost" href="/introduce/careers">포트폴리오</a>
      </div>
    </div>
  </section>

  <div class="layout">
    <div class="toolbar">
      <div>
        <h2 class="section-title">최신 글</h2>
        <p class="section-sub">총 {totalCount}개</p>
      </div>
      <div class="cat-links" aria-label="카테고리">
        {categories.map((c) => (
          <a href={`/category/${c.toLowerCase()}`} class="cat-chip">{c}</a>
        ))}
      </div>
    </div>

    <div class="posts-grid">
      {
        posts.map((post) => (
          <a class="card" href={`/${post.id}/`}>
            <div class="card-top">
              <span class="badge">{post.data.categories[0]?.split("|")[0].trim() || "글"}</span>
              <time datetime={post.data.created?.toISOString()}>{fmtDate(post.data.created ?? post.data.date)}</time>
            </div>
            <h3>{post.data.title}</h3>
            {post.data.description && <p class="desc">{post.data.description}</p>}
            <div class="card-foot">
              {post.data.readingTime && <span>약 {post.data.readingTime}분</span>}
              <span class="arrow" aria-hidden="true">→</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(900px 400px at 50% -20%, var(--brand-glow), transparent 70%),
      var(--bg);
    padding: 5rem 0 4rem;
  }
  .hero-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 1.25rem;
    text-align: center;
  }
  .hero-eyebrow {
    display: inline-block;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand);
    margin-bottom: 0.9rem;
  }
  .hero-title {
    margin: 0;
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, var(--text), var(--brand-strong));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-sub { font-size: 1.2rem; font-weight: 600; color: var(--text); margin: 0.6rem 0 0; }
  .hero-tagline { color: var(--text-2); margin: 0.3rem 0 1.8rem; }
  .hero-actions { display: flex; gap: 0.7rem; justify-content: center; }
  .btn {
    display: inline-flex;
    padding: 0.6rem 1.3rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
  }
  .btn:hover { text-decoration: none; transform: translateY(-2px); }
  .btn.primary {
    background: linear-gradient(135deg, var(--brand), var(--brand-strong));
    color: #fff;
    box-shadow: 0 6px 18px -6px var(--brand-glow);
  }
  .btn.ghost { border: 1px solid var(--border-strong); color: var(--text); background: var(--surface); }

  .layout {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 2.8rem 1.25rem 4rem;
  }
  .toolbar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.6rem;
  }
  .section-title { margin: 0; font-size: 1.5rem; }
  .section-sub { margin: 0.2rem 0 0; color: var(--text-3); font-size: 0.92rem; }
  .cat-links { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .cat-chip {
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-2);
    font-size: 0.85rem;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .cat-chip:hover { border-color: var(--brand); color: var(--brand); text-decoration: none; }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.2rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 1.3rem 1.4rem;
    color: inherit;
    box-shadow: var(--shadow-sm);
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: var(--brand);
    box-shadow: var(--shadow-md);
    text-decoration: none;
  }
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }
  .badge {
    background: var(--brand-soft);
    color: var(--brand-strong);
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
  }
  .card-top time { color: var(--text-3); font-size: 0.82rem; }
  .card h3 { margin: 0.2rem 0 0; font-size: 1.08rem; line-height: 1.4; }
  .card .desc {
    color: var(--text-2);
    font-size: 0.9rem;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }
  .card-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--text-3);
    font-size: 0.85rem;
    margin-top: 0.3rem;
  }
  .card-foot .arrow { color: var(--brand); font-weight: 700; transition: transform 0.15s ease; }
  .card:hover .arrow { transform: translateX(3px); }

  @media (max-width: 640px) {
    .posts-grid { grid-template-columns: 1fr; }
    .hero { padding: 3.5rem 0 3rem; }
  }
</style>