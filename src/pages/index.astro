---
import BaseLayout from "../layouts/BaseLayout.astro";
import LatestPosts from "../components/LatestPosts.astro";
import { getPostCategories, getPublishedPosts, POSTS_PER_PAGE } from "../lib/posts";

const posts = await getPublishedPosts();
const categories = getPostCategories(posts);
const totalCount = posts.length;
const totalPages = Math.ceil(totalCount / POSTS_PER_PAGE);
const firstPagePosts = posts.slice(0, POSTS_PER_PAGE);
---
<BaseLayout title="Raincoat" description="프론트엔드 개발자 블로그. 웹 개발 경험과 지식을 공유합니다." path="/">
  <section class="hero">
    <div class="hero-inner">
      <span class="hero-eyebrow">Frontend × AI Engineering</span>
      <h1 class="hero-title" data-pagefind-body>Raincoat</h1>
      <p class="hero-sub">사람을 위한 인터페이스를 만들고, 과정과 배움을 기록합니다.</p>
      <p class="hero-typewriter">
        <span class="typewriter-prompt" aria-hidden="true">›</span>
        <span data-typewriter aria-hidden="true">AI와 함께 더 빠르게 실험합니다</span>
        <span class="typewriter-cursor" aria-hidden="true"></span>
        <span class="visually-hidden">AI와 함께 더 빠르게 실험합니다. 복잡한 문제를 단순한 화면으로 만듭니다. 실무에서 배운 것을 기록합니다.</span>
      </p>
    </div>
  </section>

  <LatestPosts
    posts={firstPagePosts}
    categories={categories}
    totalCount={totalCount}
    currentPage={1}
    totalPages={totalPages}
  />
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(900px 400px at 50% -20%, var(--brand-glow), transparent 70%),
      var(--bg);
    padding: 5rem 0 4rem;
  }
  .hero-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 1.25rem;
    text-align: center;
  }
  .hero-eyebrow {
    display: inline-block;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand);
    margin-bottom: 0.9rem;
  }
  .hero-title {
    margin: 0;
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, var(--hero-title-start), var(--hero-title-end));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-sub {
    max-width: 34rem;
    margin: 0.8rem auto 0;
    color: var(--text);
    font-size: clamp(1rem, 2.5vw, 1.18rem);
    font-weight: 600;
  }
  .hero-typewriter {
    display: flex;
    min-height: 1.75rem;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    margin: 1.5rem auto 0;
    color: var(--text-2);
    font-family: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.92rem;
    letter-spacing: -0.01em;
  }
  .typewriter-prompt {
    color: var(--brand);
    font-size: 1.15em;
    font-weight: 700;
  }
  .typewriter-cursor {
    width: 0.5rem;
    height: 1.05em;
    border-radius: 1px;
    background: var(--brand);
    animation: cursor-blink 0.9s steps(1) infinite;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @keyframes cursor-blink {
    50% { opacity: 0; }
  }


  @media (max-width: 640px) {
    .hero { padding: 3.5rem 0 3rem; }
    .hero-sub { max-width: 18rem; }
    .hero-typewriter { font-size: 0.82rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .typewriter-cursor { animation: none; }
  }
</style>

<script>
  const typewriter = document.querySelector<HTMLElement>("[data-typewriter]");
  const phrases = [
    "AI와 함께 더 빠르게 실험합니다",
    "복잡한 문제를 단순한 화면으로 만듭니다",
    "실무에서 배운 것을 기록합니다",
  ];

  if (typewriter && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let phraseIndex = 0;
    let characterIndex = Array.from(phrases[0]).length;
    let deleting = true;

    const type = () => {
      const characters = Array.from(phrases[phraseIndex]);
      characterIndex += deleting ? -1 : 1;
      typewriter.textContent = characters.slice(0, characterIndex).join("");

      if (!deleting && characterIndex === characters.length) {
        deleting = true;
        window.setTimeout(type, 1800);
        return;
      }

      if (deleting && characterIndex === 0) {
        deleting = false;
        phraseIndex = (phraseIndex + 1) % phrases.length;
      }

      window.setTimeout(type, deleting ? 45 : 75);
    };

    window.setTimeout(type, 1400);
  }
</script>