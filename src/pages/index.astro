---
import BaseLayout from "../layouts/BaseLayout.astro";
import LatestPosts from "../components/LatestPosts.astro";
import { getPostCategories, getPublishedPosts, POSTS_PER_PAGE } from "../lib/posts";

const posts = await getPublishedPosts();
const categories = getPostCategories(posts);
const totalCount = posts.length;
const totalPages = Math.ceil(totalCount / POSTS_PER_PAGE);
const firstPagePosts = posts.slice(0, POSTS_PER_PAGE);
---
<BaseLayout title="Raincoat" description="프론트엔드 개발자 블로그. 웹 개발 경험과 지식을 공유합니다." path="/">
  <section class="hero">
    <div class="hero-inner">
      <span class="hero-eyebrow">Frontend × AI Engineering</span>
      <h1 class="hero-title" data-pagefind-body>Raincoat</h1>
      <p class="hero-sub">사람을 위한 인터페이스를 만들고, 과정과 배움을 기록합니다.</p>
      <ul class="hero-tags" role="list">
        <li>AI</li>
        <li>UI 개발</li>
        <li>실무 기록</li>
      </ul>
    </div>
  </section>

  <LatestPosts
    posts={firstPagePosts}
    categories={categories}
    totalCount={totalCount}
    currentPage={1}
    totalPages={totalPages}
  />
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(900px 400px at 50% -20%, var(--brand-glow), transparent 70%),
      var(--bg);
    padding: 5rem 0 4rem;
  }
  .hero-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 1.25rem;
    text-align: center;
  }
  .hero-eyebrow {
    display: inline-block;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand);
    margin-bottom: 0.9rem;
  }
  .hero-title {
    margin: 0;
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, var(--hero-title-start), var(--hero-title-end));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-sub {
    max-width: 34rem;
    margin: 0.8rem auto 0;
    color: var(--text);
    font-size: clamp(1rem, 2.5vw, 1.18rem);
    font-weight: 600;
  }
  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .hero-tags li {
    color: var(--brand);
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.34rem 0.85rem;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
  }

  @media (max-width: 640px) {
    .hero { padding: 3.5rem 0 3rem; }
    .hero-sub { max-width: 18rem; }
  }
</style>