---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="검색" description="Raincoat 블로그 게시글 검색" path="/search/">
  <div class="search-page">
    <header class="page-head">
      <span class="eyebrow">Search</span>
      <h1 class="kicker">검색</h1>
      <p class="sub">게시글 제목·본문을 검색하세요</p>
    </header>
    <div id="search"></div>
  </div>
</BaseLayout>

<script>
  import { PagefindUI } from "@pagefind/default-ui";
  import "@pagefind/default-ui/css/ui.css";
  new PagefindUI({ element: "#search", debouncedTimeoutMs: 300, showImages: false });
</script>

<style>
  .search-page {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 3rem 1.25rem 4rem;
  }
  .page-head { margin-bottom: 2rem; }
  .eyebrow {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand);
    margin-bottom: 0.5rem;
  }
  .kicker { margin: 0; font-size: 1.9rem; }
  .sub { color: var(--text-3); margin: 0.4rem 0 0; }
  /* pagefind UI 다크모드 대응 */
  :global(.pagefind-ui__search-input) {
    border: 1px solid var(--border) !important;
    border-radius: var(--radius) !important;
    padding: 0.7rem 1rem !important;
    color: var(--text) !important;
    background: var(--surface) !important;
  }
  :global(.pagefind-ui__search-input:focus) { outline: 2px solid var(--brand) !important; }
  :global(.pagefind-ui__result) { border-bottom: 1px solid var(--border) !important; }
  :global(.pagefind-ui__result-title) { color: var(--brand) !important; }
  :global(.pagefind-ui__result-excerpt) { color: var(--text-2) !important; }
  :global(.pagefind-ui__search-clear) {
    background: var(--brand-soft) !important;
    color: var(--brand-strong) !important;
  }
  :global(.pagefind-ui__button) {
    background: var(--surface) !important;
    border: 1px solid var(--border) !important;
    color: var(--text-2) !important;
  }
</style>