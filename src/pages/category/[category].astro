---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

type Post = CollectionEntry<"docs">;

export async function getStaticPaths() {
  function ts(q: Post): number {
    return (q.data.created ?? q.data.date)?.getTime?.() ?? 0;
  }
  const all = (await getCollection("docs")).filter(
    (p) => !!p.data.title && !p.id.includes("examples/") && !p.data.draft
  );
  const cats = new Map<string, Post[]>();
  for (const post of all) {
    const raw = post.data.categories[0];
    if (!raw) continue;
    const cat = raw.split("|")[0].trim();
    if (!cat) continue;
    if (!cats.has(cat)) cats.set(cat, []);
    cats.get(cat)!.push(post);
  }
  return [...cats.entries()].map(([category, posts]) => ({
    params: { category: category.toLowerCase() },
    props: { category, posts: [...posts].sort((a, b) => ts(b) - ts(a)) },
  }));
}

interface Props {
  category: string;
  posts: Post[];
}
const { category, posts } = Astro.props;

const fmtDate = (d?: Date) =>
  d ? new Intl.DateTimeFormat("ko-KR", { year: "numeric", month: "2-digit", day: "2-digit" }).format(d) : "";
const segments = category.toLowerCase();
---
<BaseLayout title={`${category} · 카테고리`} description={`${category} 카테고리 포스트 목록입니다.`} path={`/category/${segments}`} breadcrumb={[`category/${segments}`]}>
  <div class="page">
    <a class="back-link" href="/#latest-posts">
      <span aria-hidden="true">←</span>
      최신 글로 돌아가기
    </a>
    <header class="page-head">
      <span class="eyebrow">Category</span>
      <h1 class="kicker" data-pagefind-body>{category}</h1>
      <p class="count">총 {posts.length}개의 글</p>
    </header>

    <div class="grid">
      {posts.map((post) => (
        <a class="card" href={`/${post.id}/`}>
          <h3>{post.data.title}</h3>
          {post.data.description && <p class="desc">{post.data.description}</p>}
          <div class="foot">
            <time datetime={post.data.created?.toISOString()}>{fmtDate(post.data.created ?? post.data.date)}</time>
            {post.data.readingTime && <span>약 {post.data.readingTime}분</span>}
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page { max-width: var(--max-w); margin: 0 auto; padding: 3rem 1.25rem 4rem; }
  .page-head { margin-bottom: 2rem; }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text-2);
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.2;
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }
  .back-link:hover {
    border-color: var(--brand);
    background: var(--brand-soft);
    color: var(--brand-strong);
    text-decoration: none;
  }
  .eyebrow {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand);
    margin-bottom: 0.5rem;
  }
  .kicker { margin: 0; font-size: 1.9rem; }
  .count { color: var(--text-3); margin: 0.35rem 0 0; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.2rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 1.3rem 1.4rem;
    color: inherit;
    box-shadow: var(--shadow-sm);
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: var(--brand);
    box-shadow: var(--shadow-md);
    text-decoration: none;
  }
  .card h3 { margin: 0; font-size: 1.05rem; line-height: 1.4; }
  .card .desc {
    color: var(--text-2);
    font-size: 0.9rem;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }
  .card .foot {
    display: flex;
    gap: 0.9rem;
    color: var(--text-3);
    font-size: 0.84rem;
    margin-top: 0.3rem;
  }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
</style>